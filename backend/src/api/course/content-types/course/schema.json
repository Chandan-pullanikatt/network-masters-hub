{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Course",
    "description": "Full dynamic course management"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "richtext"
    },
    "duration": {
      "type": "string"
    },
    "modules": {
      "type": "decimal"
    },
    "videoHours": {
      "type": "decimal"
    },
    "price": {
      "type": "decimal"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "course.hero"
    },
    "overview": {
      "type": "component",
      "repeatable": true,
      "component": "course.skill"
    },
    "roadmap": {
      "type": "component",
      "repeatable": true,
      "component": "course.roadmap-item"
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq-item"
    },
    "schedule": {
      "type": "component",
      "repeatable": true,
      "component": "course.batch"
    },
    "isCombo": {
      "type": "boolean",
      "default": false
    },
    "flexiblePrice": {
      "type": "decimal"
    },
    "isFlexible": {
      "type": "boolean",
      "default": false
    }
  }
}
